# KARTLY Admin - Clean URL Rewriting
RewriteEngine On
Options -MultiViews

# Serve real files and directories directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Clean Admin URLs (no .php extension)
RewriteRule ^$                          index.php           [L,QSA]
RewriteRule ^dashboard/?$               index.php           [L,QSA]
RewriteRule ^products/?$                products.php        [L,QSA]
RewriteRule ^categories/?$              categories.php      [L,QSA]
RewriteRule ^deals/?$                   deals.php           [L,QSA]
RewriteRule ^orders/?$                  orders.php          [L,QSA]
RewriteRule ^order/([0-9]+)/?$          order-detail.php?id=$1 [L,QSA]
RewriteRule ^reviews/?$                 reviews.php         [L,QSA]
RewriteRule ^view-review/?$             view-review.php     [L,QSA]
RewriteRule ^users/?$                   users.php           [L,QSA]
RewriteRule ^coupons/?$                 coupons.php         [L,QSA]
RewriteRule ^hero/?$                    hero.php            [L,QSA]
RewriteRule ^settings/?$                settings.php        [L,QSA]
