# Rosabella Admin - Clean URL Rewriting + Security Headers
RewriteEngine On
Options -MultiViews -Indexes

# ─── Security Headers ───────────────────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    # Strict CSP for admin — allow inline styles/scripts needed for admin UI
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self'; object-src 'none'; base-uri 'self';"
    Header always unset X-Powered-By
</IfModule>

# Serve real files and directories directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Clean Admin URLs (no .php extension)
RewriteRule ^$                          index.php           [L,QSA]
RewriteRule ^dashboard/?$               index.php           [L,QSA]
RewriteRule ^products/?$                products.php        [L,QSA]
RewriteRule ^categories/?$              categories.php      [L,QSA]
RewriteRule ^deals/?$                   deals.php           [L,QSA]
RewriteRule ^orders/?$                  orders.php          [L,QSA]
RewriteRule ^order-create/?$            order-create.php    [L,QSA]
RewriteRule ^order/([0-9]+)/?$          order-detail.php?id=$1 [L,QSA]
RewriteRule ^reviews/?$                 reviews.php         [L,QSA]
RewriteRule ^view-review/?$             view-review.php     [L,QSA]
RewriteRule ^users/?$                   users.php           [L,QSA]
RewriteRule ^coupons/?$                 coupons.php         [L,QSA]
RewriteRule ^hero/?$                    hero.php            [L,QSA]
RewriteRule ^website-settings/?$         website_settings.php [L,QSA]
RewriteRule ^website_settings/?$         website_settings.php [L,QSA]
RewriteRule ^settings/?$                settings.php        [L,QSA]
RewriteRule ^notifications/?$           notifications.php    [L,QSA]
RewriteRule ^customers/?$               customers.php       [L,QSA]

