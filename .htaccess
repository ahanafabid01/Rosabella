# KARTLY - Apache Configuration
# Organized structure: root index.php (homepage), /public/ (shop), /pages/ (info), /admin/, /api/, /errors/

# Enable rewrite engine
RewriteEngine On

# ─────────────────────────────────────────────────────────────
# SECTION 1: Force HTTPS (uncomment in production)
# ─────────────────────────────────────────────────────────────
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ─────────────────────────────────────────────────────────────
# SECTION 2: Security — prevent directory listing & protect files
# ─────────────────────────────────────────────────────────────
Options -Indexes -MultiViews

# Block direct access to sensitive directories
RedirectMatch 403 ^/(Kartly/)?config/
RedirectMatch 403 ^/(Kartly/)?database/
RedirectMatch 403 ^/(Kartly/)?errors/(?!$|404\.php$|500\.php$)

# Protect sensitive file types
<FilesMatch "\.(sql|log|ini|conf|env)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# ─────────────────────────────────────────────────────────────
# SECTION 3: Static assets — serve directly (no rewriting)
# ─────────────────────────────────────────────────────────────
RewriteRule ^assets/ - [L]

# ─────────────────────────────────────────────────────────────
# SECTION 4: Admin panel — let admin/.htaccess handle routing
# ─────────────────────────────────────────────────────────────
RewriteRule ^admin/ - [L]

# ─────────────────────────────────────────────────────────────
# SECTION 5: API endpoints — serve directly from /api/
# ─────────────────────────────────────────────────────────────
RewriteRule ^api/ - [L]

# ─────────────────────────────────────────────────────────────
# SECTION 6: Front controller — PHP resolves clean routes
# ─────────────────────────────────────────────────────────────
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^ index.php [L,QSA]


# ─────────────────────────────────────────────────────────────
# SECTION 9: Error pages
# ─────────────────────────────────────────────────────────────
ErrorDocument 404 /index.php
ErrorDocument 500 /errors/500.php

<IfModule mod_php7.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 10M
    php_value max_execution_time 300
</IfModule>

<IfModule mod_php8.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 10M
    php_value max_execution_time 300
</IfModule>

AddDefaultCharset UTF-8

# ─────────────────────────────────────────────────────────────
# SECTION 10: Performance — Compression
# ─────────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css
    AddOutputFilterByType DEFLATE application/xml application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json image/svg+xml
    DeflateCompressionLevel 6
</IfModule>

<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css
    AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json
</IfModule>

# ─────────────────────────────────────────────────────────────
# SECTION 11: Performance — Browser Caching
# ─────────────────────────────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg          "access plus 1 year"
    ExpiresByType image/jpeg         "access plus 1 year"
    ExpiresByType image/gif          "access plus 1 year"
    ExpiresByType image/png          "access plus 1 year"
    ExpiresByType image/webp         "access plus 1 year"
    ExpiresByType image/svg+xml      "access plus 1 year"
    ExpiresByType image/x-icon       "access plus 1 year"
    ExpiresByType font/woff          "access plus 1 year"
    ExpiresByType font/woff2         "access plus 1 year"
    ExpiresByType text/css           "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/html          "access plus 0 seconds"
    ExpiresDefault                   "access plus 1 week"
</IfModule>

# Cache-Control headers + ETags
<IfModule mod_headers.c>
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico|woff|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
        FileETag None
        Header unset ETag
    </FilesMatch>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=2592000, stale-while-revalidate=86400"
        Header append Vary Accept-Encoding
    </FilesMatch>
    Header always set X-Content-Type-Options "nosniff"
</IfModule>
