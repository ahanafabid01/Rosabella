# ROSABELLA - Apache Configuration
# Organized structure: root index.php (homepage), /public/ (shop), /pages/ (info), /admin/, /api/, /errors/
# Base URL is dynamically detected from folder name in config/database.php

# Enable rewrite engine
RewriteEngine On

# ─────────────────────────────────────────────────────────────
# SECTION 1: Force HTTPS (uncomment in production with SSL cert)
# ─────────────────────────────────────────────────────────────
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ─────────────────────────────────────────────────────────────
# SECTION 2: Security — block sensitive directories & files
# ─────────────────────────────────────────────────────────────
Options -Indexes -MultiViews

# Block direct access to sensitive directories
RedirectMatch 403 ^/config/
RedirectMatch 403 ^/database/
RedirectMatch 403 ^/logs/
RedirectMatch 403 ^/errors/(?!$|404\.php$|500\.php$)

# Block access to Git, agents, and hidden directories (prevents source code dumping)
RedirectMatch 403 ^/\.git
RedirectMatch 403 ^/\.agents
RedirectMatch 403 ^/\.env

# Protect sensitive file types
<FilesMatch "\.(sql|log|ini|conf|env|bak|swp|sh|bash)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Protect composer files
<FilesMatch "(composer\.(json|lock)|package\.json|package-lock\.json|\.gitignore|README\.md)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# ─────────────────────────────────────────────────────────────
# SECTION 3: Limit request body size (DoS protection)
# ─────────────────────────────────────────────────────────────
LimitRequestBody 10485760

# ─────────────────────────────────────────────────────────────
# SECTION 4: Static assets — serve directly (no rewriting)
# ─────────────────────────────────────────────────────────────
RewriteRule ^assets/ - [L]

# ─────────────────────────────────────────────────────────────
# SECTION 5: Admin panel — let admin/.htaccess handle routing
# ─────────────────────────────────────────────────────────────
RewriteRule ^admin/ - [L]

# ─────────────────────────────────────────────────────────────
# SECTION 6: API endpoints — serve directly from /api/
# ─────────────────────────────────────────────────────────────
RewriteRule ^api/ - [L]

# ─────────────────────────────────────────────────────────────
# SECTION 7: Front controller — PHP resolves clean routes
# ─────────────────────────────────────────────────────────────
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^ index.php [L,QSA]

# ─────────────────────────────────────────────────────────────
# SECTION 8: Error pages
# ─────────────────────────────────────────────────────────────
ErrorDocument 404 /index.php
ErrorDocument 500 /errors/500.php

# ─────────────────────────────────────────────────────────────
# SECTION 9: PHP limits
# ─────────────────────────────────────────────────────────────
<IfModule mod_php7.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 10M
    php_value max_execution_time 300
</IfModule>

<IfModule mod_php8.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 10M
    php_value max_execution_time 300
</IfModule>

AddDefaultCharset UTF-8

# ─────────────────────────────────────────────────────────────
# SECTION 10: Security Headers
# ─────────────────────────────────────────────────────────────
<IfModule mod_headers.c>
    # Prevent clickjacking attacks
    Header always set X-Frame-Options "SAMEORIGIN"

    # Prevent MIME-type sniffing attacks
    Header always set X-Content-Type-Options "nosniff"

    # Enable XSS filter in older browsers
    Header always set X-XSS-Protection "1; mode=block"

    # Control referrer information sent with requests
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Disable access to browser APIs that aren't needed
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"

    # HTTP Strict Transport Security — only active on HTTPS connections
    # max-age=31536000 = 1 year; remove 'env=HTTPS' prefix to force on HTTP too (don't do that)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS

    # Content Security Policy — controls which resources are allowed to load
    # Adjust 'connect-src' if you add external analytics/APIs
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://fonts.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self'; frame-ancestors 'self'; object-src 'none'; base-uri 'self';"

    # Remove server version disclosure
    Header always unset X-Powered-By
    Header always unset Server
</IfModule>

# ─────────────────────────────────────────────────────────────
# SECTION 11: Performance — Compression
# ─────────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css
    AddOutputFilterByType DEFLATE application/xml application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json image/svg+xml
    DeflateCompressionLevel 6
</IfModule>

<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css
    AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json
</IfModule>

# ─────────────────────────────────────────────────────────────
# SECTION 12: Performance — Browser Caching
# ─────────────────────────────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg          "access plus 1 year"
    ExpiresByType image/jpeg         "access plus 1 year"
    ExpiresByType image/gif          "access plus 1 year"
    ExpiresByType image/png          "access plus 1 year"
    ExpiresByType image/webp         "access plus 1 year"
    ExpiresByType image/svg+xml      "access plus 1 year"
    ExpiresByType image/x-icon       "access plus 1 year"
    ExpiresByType font/woff          "access plus 1 year"
    ExpiresByType font/woff2         "access plus 1 year"
    ExpiresByType text/css           "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/html          "access plus 0 seconds"
    ExpiresDefault                   "access plus 1 week"
</IfModule>

# Cache-Control headers + ETags
<IfModule mod_headers.c>
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico|woff|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
        FileETag None
        Header unset ETag
    </FilesMatch>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=2592000, stale-while-revalidate=86400"
        Header append Vary Accept-Encoding
    </FilesMatch>
</IfModule>
